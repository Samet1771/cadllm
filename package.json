{
  "name": "cadllm",
  "private": true,
  "version": "0.0.0",
  "description": "AI-first breadboard, schematic and PCB designer and simulator",
  "license": "GPL-3.0-or-later WITH LicenseRef-CadLLM-plugin-exception",
  "type": "module",
